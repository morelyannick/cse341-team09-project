<%- include('../partials/header') %>
<h1><%- title %></h1>

<div id="filters" data-selected-region="<%= query.region || 'all' %>" data-selected-season="<%= query.season || 'all' %>">
    Search by Region:
    <select id="region-filter">
        <option value="all">All Regions</option>
    </select>

    Search by Season:
    <select id="season-filter">
        <option value="all">Any Season</option>
    </select>
</div>

<p id="trips-loading" role="status">Loading trips…</p>
<p id="trips-error" role="alert" hidden></p>
<p id="trips-empty" hidden>No trips match your selected filters.</p>
<div id="trips-grid" class="routes-grid"></div>

<script src="/js/trips.js" defer></script>
<%- include('../partials/footer') %>