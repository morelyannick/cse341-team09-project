<%- include('./partials/header') %>

<section class="trains-hero">
    <h1>Learn about our Trains</h1>
    <p>
        Explore the physical trains that power scenic the trips across the Kizuna Rail network.
    </p>
</section>

<section class="trains-catalog">
    <div class="trains-toolbar">
        <div class="toolbar-group search-group">
            <label for="trains-search">Search Trains</label>
            <input type="search" id="trains-search" placeholder="Search by name, description..." autocomplete="off">
        </div>
        <div class="toolbar-group">
            <label for="trains-power-filter">Power Source</label>
            <select id="trains-power-filter">
                <option value="">All Power Sources</option>
                <option value="Electric">Electric</option>
                <option value="Diesel">Diesel</option>
                <option value="Steam">Steam</option>
            </select>
        </div>
        <div class="toolbar-group">
            <label for="trains-sort">Sort By</label>
            <select id="trains-sort">
                <option value="name:asc">Name (A-Z)</option>
                <option value="name:desc">Name (Z-A)</option>
                <option value="maxSpeedKmh:desc">Top Speed (Fastest)</option>
                <option value="maxSpeedKmh:asc">Top Speed (Slowest)</option>
                <option value="capacity:desc">Capacity (Highest)</option>
                <option value="capacity:asc">Capacity (Lowest)</option>
            </select>
        </div>
    </div>

    <div class="trains-state" id="trains-loading">Loading trains...</div>
    <div class="trains-state trains-error" id="trains-error" hidden></div>

    <div class="trains-grid" id="trains-list"></div>

    <nav class="trains-pagination" id="trains-pagination" aria-label="Trains pagination" hidden>
        <button type="button" class="pagination-btn" id="trains-prev-btn" disabled>&larr; Previous</button>
        <span class="pagination-info" id="trains-page-info">Page 1 of 1</span>
        <button type="button" class="pagination-btn" id="trains-next-btn" disabled>Next &rarr;</button>
    </nav>

    <template id="train-card-template">
        <article class="train-card">
            <div class="train-image-wrap">
                <img data-field="image" loading="lazy" decoding="async">
            </div>

            <header class="train-card-header">
                <h2 data-field="name"></h2>
                <span class="train-operator" data-field="operator"></span>
            </header>

            <p class="train-description" data-field="description"></p>

            <dl class="train-specs">
                <div class="spec-item">
                    <dt>Type</dt>
                    <dd data-field="type"></dd>
                </div>
                <div class="spec-item">
                    <dt>Top Speed</dt>
                    <dd data-field="speed"></dd>
                </div>
                <div class="spec-item">
                    <dt>Capacity</dt>
                    <dd data-field="seats"></dd>
                </div>
                <div class="spec-item">
                    <dt>Power</dt>
                    <dd data-field="power"></dd>
                </div>
            </dl>

            <p class="train-best-for">
                <strong>Best For:</strong>
                <span data-field="best-for"></span>
            </p>
        </article>
    </template>
</section>

<%- include('./partials/footer') %>
